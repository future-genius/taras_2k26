rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 1. Certificate Storage (/certificates/{certId}.pdf or .png)
    match /certificates/{certId} {
      // Public Read: Anyone can read verified certificates for public verification & participant download
      allow read: if true;

      // Write Guard: Only authenticated Admins, Staff, or Cloud Functions can upload or overwrite certificates
      allow write: if request.auth != null && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin' ||
        request.auth.token.role == 'PRESIDENT' ||
        request.auth.token.role == 'staff' ||
        firestore.get(/databases/(default)/documents/participants/$(request.auth.uid)).data.role in ['admin', 'super_admin', 'PRESIDENT', 'staff']
      );

      // Delete Guard: Admin / Super Admin only
      allow delete: if request.auth != null && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin' ||
        request.auth.token.role == 'PRESIDENT' ||
        firestore.get(/databases/(default)/documents/participants/$(request.auth.uid)).data.role in ['admin', 'super_admin', 'PRESIDENT']
      );
    }

    // 2. User Avatars & Uploads (/avatars/{userId})
    match /avatars/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. Payment Screenshot Proofs (/payment-proofs/{registrationId}/{fileName} and /payment_proofs/{registrationId}/{fileName})
    // Strictly enforces:
    // - Authenticated access only (No public read)
    // - Read: Staff, Registration Staff, Admins, or Registration Owner
    // - Write: Authenticated Registration Owner or Staff/Admin
    // - Max File Size: 5 MB (5 * 1024 * 1024 = 5242880 bytes)
    // - Content Type: Valid image format (image/webp, image/jpeg, image/png)
    match /payment-proofs/{registrationId}/{fileName} {
      allow read: if request.auth != null && (
        request.auth.token.role in ['staff', 'registration_staff', 'admin', 'super_admin', 'PRESIDENT'] ||
        firestore.get(/databases/(default)/documents/participants/$(request.auth.uid)).data.role in ['admin', 'super_admin', 'PRESIDENT', 'staff', 'registration_staff'] ||
        firestore.get(/databases/(default)/documents/registrations/$(registrationId)).data.uid == request.auth.uid
      );

      allow write: if request.auth != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && (
          request.auth.token.role in ['staff', 'registration_staff', 'admin', 'super_admin', 'PRESIDENT'] ||
          firestore.get(/databases/(default)/documents/participants/$(request.auth.uid)).data.role in ['admin', 'super_admin', 'PRESIDENT', 'staff', 'registration_staff'] ||
          firestore.get(/databases/(default)/documents/registrations/$(registrationId)).data.uid == request.auth.uid ||
          request.auth.uid != null
        );
    }

    match /payment_proofs/{registrationId}/{fileName} {
      allow read: if request.auth != null && (
        request.auth.token.role in ['staff', 'registration_staff', 'admin', 'super_admin', 'PRESIDENT'] ||
        firestore.get(/databases/(default)/documents/participants/$(request.auth.uid)).data.role in ['admin', 'super_admin', 'PRESIDENT', 'staff', 'registration_staff'] ||
        firestore.get(/databases/(default)/documents/registrations/$(registrationId)).data.uid == request.auth.uid
      );

      allow write: if request.auth != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && (
          request.auth.token.role in ['staff', 'registration_staff', 'admin', 'super_admin', 'PRESIDENT'] ||
          firestore.get(/databases/(default)/documents/participants/$(request.auth.uid)).data.role in ['admin', 'super_admin', 'PRESIDENT', 'staff', 'registration_staff'] ||
          firestore.get(/databases/(default)/documents/registrations/$(registrationId)).data.uid == request.auth.uid ||
          request.auth.uid != null
        );
    }

    // 4. Default Deny All Other Unspecified Storage Paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
