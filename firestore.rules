rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // Helper Functions
    // ─────────────────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Retrieve caller's profile document from Firestore
    function getCallerProfile() {
      return get(/databases/$(database)/documents/participants/$(request.auth.uid)).data;
    }

    // Check if the caller's participant profile document exists in Firestore
    function callerProfileExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/participants/$(request.auth.uid));
    }

    // Role helper methods — safe: returns 'participant' if profile doc doesn't exist yet.
    // This prevents the circular-read failure where reading a participant doc triggers
    // getUserRole() which triggers another read that fails and denies the original request.
    function getUserRole() {
      return callerProfileExists()
        ? getCallerProfile().role
        : 'participant';
    }

    // ── Tier 1: PRESIDENT / SUPER_ADMIN ─────────────────────────────────────
    // Only role === 'super_admin' qualifies. 'PRESIDENT' legacy alias also accepted.
    function isSuperAdmin() {
      return isAuthenticated() && (
        getUserRole() == 'super_admin' ||
        getUserRole() == 'PRESIDENT'
      );
    }

    // ── Tier 2: ADMIN (does NOT include super_admin for admin-only logic) ────
    function isStrictAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    // ── Tier 2+: Admin OR above (for shared admin operations) ───────────────
    function isAdmin() {
      return isSuperAdmin() || isStrictAdmin();
    }

    // ── Tier 3: STAFF and above ──────────────────────────────────────────────
    function isStaff() {
      return isAuthenticated() && (
        getUserRole() == 'staff' ||
        getUserRole() == 'registration_staff' ||
        getUserRole() == 'REGISTRATION_TEAM' ||
        isAdmin()
      );
    }

    // ── Tier 4: COORDINATOR / EVENT HEAD and above ───────────────────────────
    function isCoordinator() {
      return isAuthenticated() && (
        getUserRole() == 'coordinator' ||
        getUserRole() == 'EVENT_HEAD' ||
        isAdmin()
      );
    }

    function isCoordinatorForEvent(eventId) {
      return isAuthenticated() && (
        isAdmin() ||
        (
          isCoordinator() &&
          ('assignedEventIds' in getCallerProfile()) &&
          getCallerProfile().assignedEventIds.hasAny([eventId])
        )
      );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Security Guards — prevent privilege escalation to super_admin
    // ─────────────────────────────────────────────────────────────────────────

    // True if the incoming write is attempting to set role = super_admin
    function isAttemptingToBecomeSuperAdmin() {
      return 'role' in request.resource.data &&
        (request.resource.data.role == 'super_admin' ||
         request.resource.data.role == 'PRESIDENT');
    }

    // True if the document being written currently belongs to a super_admin
    function isTargetSuperAdmin() {
      return resource != null &&
        'role' in resource.data &&
        (resource.data.role == 'super_admin' || resource.data.role == 'PRESIDENT');
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 1. Participant Profiles (/participants/{userId})
    // ─────────────────────────────────────────────────────────────────────────

    match /participants/{userId} {
      // Read: Users can read their own profile; staff, coordinators, and admins can read operational profiles.
      // Arbitrary participant enumeration/scraping by unrelated participants is blocked.
      allow read: if isOwner(userId) || isStaff() || isCoordinator() || isAdmin();

      // Create: Authenticated users can create ONLY their own profile with default security state.
      // NEVER allowed to self-create as super_admin.
      allow create: if (
        isOwner(userId) &&
        request.resource.data.uid == userId &&
        (
          !('role' in request.resource.data) ||
          request.resource.data.role == 'participant' ||
          request.resource.data.role == 'PARTICIPANT'
        ) &&
        (
          !('assignedEventIds' in request.resource.data) ||
          request.resource.data.assignedEventIds.size() == 0
        ) &&
        // Explicitly forbid isPrimarySuperAdmin from being set by self
        !('isPrimarySuperAdmin' in request.resource.data)
      ) || (
        isAuthenticated() &&
        userId == 'taras_demo_participant_001' &&
        request.resource.data.isDemo == true
      );

      // Update rules:
      // RULE A — super_admin: can update any profile, including other super_admin profiles.
      //   Exception: cannot remove isPrimarySuperAdmin flag from primary account.
      // RULE B — admin (strict, NOT super_admin): can update profiles EXCEPT:
      //   - Cannot target a super_admin profile
      //   - Cannot promote anyone to super_admin
      //   - Cannot set isPrimarySuperAdmin
      // RULE C — staff: can only update venue check-in fields.
      // RULE D — coordinator: can only update attendance/shortlist fields.
      // RULE E — any authenticated user (owner or team leader): can update non-security fields
      //   (bio, registeredEvents, teamIds, updatedAt) without being able to alter security roles,
      //   check-in status, certificate status, tokens, or primary admin status.
      allow update: if
        // RULE 1: Owner (or demo participant) updating non-security profile fields
        // Evaluated FIRST so no circular or cross-document get() reads occur for normal participants
        (isAuthenticated() &&
         (isOwner(userId) || userId == 'taras_demo_participant_001') &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'role',
           'isPrimarySuperAdmin',
           'venueCheckIn',
           'venueCheckInStatus',
           'venueCheckInTimestamp',
           'checkedInByStaffUid',
           'certificateStatus',
           'certificateUrl',
           'certificateEligible',
           'assignedEventIds',
           'attendanceStatus',
           'shortlistStatus',
           'participantId',
           'qrToken',
           'registeredEvents',
           'paymentStatus',
           'paymentVerifiedAt',
           'paymentVerifiedBy',
           'paymentRejectedAt',
           'paymentRejectedBy'
         ]))

        // RULE A: super_admin has full update authority
        || isSuperAdmin()

        // RULE B: admin can update non-super_admin profiles, cannot escalate to super_admin
        || (isStrictAdmin() &&
            !isTargetSuperAdmin() &&
            !isAttemptingToBecomeSuperAdmin() &&
            !('isPrimarySuperAdmin' in request.resource.data))

        // RULE C: staff can update venue check-in status and payment-verified registeredEvents
        || (isStaff() &&
            !isAdmin() &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['venueCheckIn', 'venueCheckInStatus', 'venueCheckInTimestamp', 'checkedInByStaffUid', 'registeredEvents', 'updatedAt']))

        // RULE D: coordinator can update attendance and shortlist for assigned events ONLY
        || (isCoordinator() &&
            !isAdmin() &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['attendanceStatus', 'shortlistStatus', 'updatedAt']) &&
            ('assignedEventIds' in getCallerProfile()) &&
            (
              !('attendanceStatus' in request.resource.data) ||
              resource == null ||
              !('attendanceStatus' in resource.data) ||
              getCallerProfile().assignedEventIds.hasAll(request.resource.data.attendanceStatus.diff(resource.data.attendanceStatus).affectedKeys())
            ) &&
            (
              !('shortlistStatus' in request.resource.data) ||
              resource == null ||
              !('shortlistStatus' in resource.data) ||
              getCallerProfile().assignedEventIds.hasAll(request.resource.data.shortlistStatus.diff(resource.data.shortlistStatus).affectedKeys())
            ));

      // Delete: Only super_admin can delete a super_admin profile.
      // Admin can delete non-super_admin profiles.
      allow delete: if isSuperAdmin() ||
        (isStrictAdmin() && !isTargetSuperAdmin());
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 2. Event Registrations (/registrations/{registrationId})
    // ─────────────────────────────────────────────────────────────────────────

    match /registrations/{registrationId} {
      // Read: Authenticated users (participants checking registration status, team members, staff, admins)
      allow read: if isAuthenticated();

      // Create: Participant can create their own registration in PENDING/PENDING_PAYMENT status.
      // Strictly FORBIDS self-creating with status = CONFIRMED, VERIFIED, or unauthorized NOT_REQUIRED.
      allow create: if isAuthenticated() &&
        (
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.uid == 'taras_demo_participant_001' ||
          isAdmin() || isStaff()
        ) &&
        (
          isAdmin() || isStaff() ||
          (
            (
              // Case 1: Paid Event Registration (Must start as PENDING or PENDING_PAYMENT)
              (
                (
                  !('status' in request.resource.data) ||
                  request.resource.data.status == 'PENDING' ||
                  request.resource.data.status == 'PENDING_PAYMENT'
                ) &&
                (
                  !('paymentStatus' in request.resource.data) ||
                  request.resource.data.paymentStatus == 'PENDING' ||
                  request.resource.data.paymentStatus == 'PENDING_PAYMENT'
                )
              )
              ||
              // Case 2: Confirmed Free Event Registration (Requires verified fee == 0 event or ₹0 fee in Firestore)
              (
                request.resource.data.status == 'CONFIRMED' &&
                request.resource.data.paymentStatus == 'NOT_REQUIRED' &&
                (
                  (
                    'eventId' in request.resource.data &&
                    exists(/databases/$(database)/documents/events/$(request.resource.data.eventId)) &&
                    (
                      get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.fee == 0 ||
                      get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.isFree == true
                    )
                  )
                  ||
                  (
                    request.resource.data.calculatedFee == 0
                  )
                )
              )
            ) &&
            !('paymentVerifiedBy' in request.resource.data) &&
            !('paymentVerifiedAt' in request.resource.data) &&
            !('paymentRejectedBy' in request.resource.data) &&
            !('paymentRejectedAt' in request.resource.data) &&
            (
              !('certificateEligible' in request.resource.data) ||
              request.resource.data.certificateEligible == false
            ) &&
            (
              !('eventAttendance' in request.resource.data) ||
              request.resource.data.eventAttendance == 'NOT_MARKED'
            ) &&
            (
              !('shortlistStatus' in request.resource.data) ||
              request.resource.data.shortlistStatus == 'NOT_EVALUATED'
            )
          )
        );

      // Update:
      // A. Staff / Registration Staff / Admin: Can perform payment verification and rejection
      // B. Participant Owner: Can only update payment proof fields (utrNumber, paymentScreenshotUrl, paymentSubmittedAt, status→PAYMENT_VERIFICATION_PENDING)
      //    Strictly CANNOT set paymentStatus = VERIFIED or status = CONFIRMED.
      //    CANNOT set paymentVerifiedBy/At, feeAmount, calculatedFee, feePerPerson, isFirstPayment, teamMemberCount.
      allow update: if (
        isStaff()
      ) || (
        isAuthenticated() &&
        (resource.data.uid == request.auth.uid || resource.data.uid == 'taras_demo_participant_001') &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'paymentStatus',
          'paymentVerifiedBy',
          'paymentVerifiedAt',
          'paymentRejectedBy',
          'paymentRejectedAt',
          'feeAmount',
          'calculatedFee',
          'feePerPerson',
          'isFirstPayment',
          'teamMemberCount',
          'participantId',
          'uid',
          'eventId'
        ]) &&
        request.resource.data.status != 'CONFIRMED'
      );

      // Delete: Admin, or participant deleting their own safe unsubmitted/pending registration (PENDING or PENDING_PAYMENT)
      // Strictly FORBIDS self-deletion once a UTR, payment proof submission, or verification has occurred.
      allow delete: if isAdmin() || (
        isAuthenticated() &&
        (resource.data.uid == request.auth.uid || resource.data.uid == 'taras_demo_participant_001') &&
        (resource.data.status == 'PENDING' || resource.data.status == 'PENDING_PAYMENT') &&
        (!('paymentStatus' in resource.data) || resource.data.paymentStatus == 'PENDING') &&
        !('paymentVerifiedBy' in resource.data) &&
        !('utrNumber' in resource.data) &&
        !('paymentSubmittedAt' in resource.data)
      );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 2.1. UTR Registry & Payment Proof Documents
    // ─────────────────────────────────────────────────────────────────────────

    match /utr_registry/{normalizedUtr} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (
        request.resource.data.uid == request.auth.uid ||
        isAdmin() ||
        isStaff()
      );
      allow delete: if isAdmin();
    }

    match /payment_proofs/{registrationId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (
        request.resource.data.uid == request.auth.uid ||
        isAdmin() ||
        isStaff()
      );
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 3. Teams (/teams/{teamId})
    // ─────────────────────────────────────────────────────────────────────────

    match /teams/{teamId} {
      // Read: Authenticated participants can read and query teams (for unique name checking, code lookup, and roster display)
      allow read: if isAuthenticated();

      // Create: Authenticated participant creating squad as leader with themselves as initial member
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          request.resource.data.leaderUid == request.auth.uid &&
          request.resource.data.memberUids.size() == 1 &&
          request.resource.data.memberUids[0] == request.auth.uid &&
          request.resource.data.memberCount >= 1 &&
          request.resource.data.memberCount <= 10 &&
          (!('eventRegistrationStarted' in request.resource.data) || request.resource.data.eventRegistrationStarted == false)
        )
      );

      // Update:
      // A. Admin has full update authority
      // B. Team Leader:
      //    - Protected fields (teamId, teamCode, leaderUid, leaderParticipantId, memberCount) are strictly IMMUTABLE.
      //    - When unlocked: may update composition up to declared memberCount.
      //    - When locked: composition fields (members, memberUids, memberCount, status) are locked.
      // C. Non-leader member:
      //    - Can ONLY update to voluntarily LEAVE the squad before locking.
      //    - Cannot modify leaderUid, memberCount, teamCode, or other members.
      allow update: if isAdmin() || (
        isAuthenticated() &&
        // Strict immutability of core structural fields for all participant writes
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.teamCode == resource.data.teamCode &&
        request.resource.data.leaderUid == resource.data.leaderUid &&
        request.resource.data.leaderParticipantId == resource.data.leaderParticipantId &&
        request.resource.data.memberCount == resource.data.memberCount &&
        (!('eventId' in resource.data) || request.resource.data.eventId == resource.data.eventId) &&
        (!('createdBy' in resource.data) || request.resource.data.createdBy == resource.data.createdBy) &&
        (
          // CASE 1: Team Leader updating
          (
            (resource.data.leaderUid == request.auth.uid || resource.data.leaderUid == 'taras_demo_participant_001') &&
            (
              // If NOT locked: leader can update composition up to declared memberCount
              (
                (!('eventRegistrationStarted' in resource.data) || resource.data.eventRegistrationStarted != true) &&
                request.resource.data.memberUids.size() <= resource.data.memberCount &&
                request.resource.data.memberUids.hasAll([resource.data.leaderUid])
              ) ||
              // If locked: composition fields cannot be altered
              (
                resource.data.eventRegistrationStarted == true &&
                !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                  'memberUids', 'members', 'memberCount', 'status'
                ])
              )
            )
          )
          ||
          // CASE 2: Non-leader squad member voluntarily leaving unlocked squad
          (
            request.auth.uid in resource.data.memberUids &&
            request.auth.uid != resource.data.leaderUid &&
            (!('eventRegistrationStarted' in resource.data) || resource.data.eventRegistrationStarted != true) &&
            !(request.auth.uid in request.resource.data.memberUids) &&
            request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1 &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members', 'status', 'updatedAt'])
          )
        )
      );

      // Delete: Admin can delete any team. Leader can delete their own (non-locked) team.
      allow delete: if isAdmin() || (
        isAuthenticated() &&
        (resource.data.leaderUid == request.auth.uid || resource.data.leaderUid == 'taras_demo_participant_001') &&
        resource.data.eventRegistrationStarted != true
      );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 3.0. Team Codes Projection (/team_codes/{teamCode})
    // ─────────────────────────────────────────────────────────────────────────

    match /team_codes/{teamCode} {
      // Public validation of team code before joining (contains NO member PII, emails, or QR tokens)
      allow read: if isAuthenticated();

      // Only team leader creating the squad, staff, or admin can create projection
      allow create: if isAuthenticated() && (
        request.resource.data.leaderUid == request.auth.uid ||
        isStaff() ||
        isAdmin()
      );

      // Only team leader, team members, staff, coordinators, or admin can update projection
      allow update: if isAuthenticated() && (
        resource.data.leaderUid == request.auth.uid ||
        (
          resource.data.teamId != null &&
          exists(/databases/$(database)/documents/teams/$(resource.data.teamId)) &&
          request.auth.uid in get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.memberUids
        ) ||
        isStaff() ||
        isCoordinator() ||
        isAdmin()
      );

      // Only team leader or admin can delete projection
      allow delete: if isAuthenticated() && (
        resource.data.leaderUid == request.auth.uid ||
        isAdmin()
      );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 3.1. Team Join Requests (/team_join_requests/{requestId})
    // ─────────────────────────────────────────────────────────────────────────

    match /team_join_requests/{requestId} {
      // Read: Request creator, team leader, or admin
      allow read: if isAuthenticated() && (
        resource.data.participantUid == request.auth.uid ||
        resource.data.leaderUid == request.auth.uid ||
        isAdmin()
      );

      // Create: Request creator only, must start in PENDING status.
      // Sensitive data (qrToken) is STRICTLY PROHIBITED in join requests.
      allow create: if isAuthenticated() &&
        request.resource.data.participantUid == request.auth.uid &&
        request.resource.data.status == 'PENDING' &&
        !('qrToken' in request.resource.data);

      // Update: Team Leader updating status to APPROVED or REJECTED (without altering teamId, requesterId, etc.) or Admin
      allow update: if (
        isAuthenticated() &&
        resource.data.leaderUid == request.auth.uid &&
        (request.resource.data.status == 'APPROVED' || request.resource.data.status == 'REJECTED') &&
        !('qrToken' in request.resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'teamId', 'teamCode', 'leaderUid', 'participantUid', 'participantId', 'fullName', 'email', 'college', 'qrToken', 'requestedAt'
        ])
      ) || isAdmin();

      // Delete: Request creator, team leader, or admin
      allow delete: if isAuthenticated() && (
        resource.data.participantUid == request.auth.uid ||
        resource.data.leaderUid == request.auth.uid ||
        isAdmin()
      );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 3.2. UTR Uniqueness Registry (/utr_registry/{utr})
    // ─────────────────────────────────────────────────────────────────────────

    match /utr_registry/{utr} {
      allow read: if isStaff() || isAdmin();
      // Only authenticated user owning a valid existing registration can register UTR
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        'registrationId' in request.resource.data &&
        exists(/databases/$(database)/documents/registrations/$(request.resource.data.registrationId)) &&
        get(/databases/$(database)/documents/registrations/$(request.resource.data.registrationId)).data.uid == request.auth.uid;
      // Update: only allowed for the same registration by the same owner (e.g. resubmissions)
      allow update: if isAuthenticated() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.registrationId == resource.data.registrationId;
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 4. Event Check-Ins (/event_checkins/{checkInId})
    // ─────────────────────────────────────────────────────────────────────────

    match /event_checkins/{checkInId} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        isStaff() ||
        (isCoordinator() && isCoordinatorForEvent(resource.data.eventId)) ||
        isAdmin()
      );

      allow create: if isAdmin() || (
        isCoordinator() &&
        isCoordinatorForEvent(request.resource.data.eventId) &&
        (!('checkedInByUid' in request.resource.data) || request.resource.data.checkedInByUid == request.auth.uid)
      );

      allow update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 5. Scorecards (/scorecards/{scorecardId})
    // ─────────────────────────────────────────────────────────────────────────

    match /scorecards/{scorecardId} {
      allow read: if isAdmin() || isStaff() || (
        isCoordinator() &&
        isCoordinatorForEvent(resource.data.eventId)
      );

      allow create: if isAdmin() || (
        isCoordinator() &&
        isCoordinatorForEvent(request.resource.data.eventId) &&
        (!('judgeUid' in request.resource.data) || request.resource.data.judgeUid == request.auth.uid)
      );

      allow update: if isAdmin() || (
        isCoordinator() &&
        isCoordinatorForEvent(resource.data.eventId) &&
        resource.data.status != 'SUBMITTED' &&
        (!('judgeUid' in request.resource.data) || request.resource.data.judgeUid == request.auth.uid)
      );

      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 6. Results (/results/{resultId})
    // ─────────────────────────────────────────────────────────────────────────

    match /results/{resultId} {
      allow read: if (resource.data.status == 'PUBLISHED') || isAdmin() || (
        isCoordinator() &&
        isCoordinatorForEvent(resource.data.eventId)
      );

      allow write: if isAdmin() || (
        isCoordinator() &&
        isCoordinatorForEvent(request.resource.data.eventId)
      );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 7. Atomic Used Transaction IDs Lock (/used_transaction_ids/{normalizedTxnId})
    // ─────────────────────────────────────────────────────────────────────────

    match /used_transaction_ids/{normalizedTxnId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.submittedByUid == request.auth.uid || isAdmin() || isStaff()
      );
      allow update: if isAuthenticated() && (
        resource.data.submittedByUid == request.auth.uid || isAdmin() || isStaff()
      );
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 8. Audit Trail (/audit_logs/{logId})
    // IMMUTABLE: update and delete are STRICTLY FORBIDDEN.
    // ─────────────────────────────────────────────────────────────────────────

    match /audit_logs/{logId} {
      // Read: Admin and super_admin
      allow read: if isAdmin();

      // Create: Authorized operational roles or participants logging payment submissions
      allow create: if isAuthenticated() &&
        (
          isStaff() || isCoordinator() || isAdmin() ||
          ('action' in request.resource.data && request.resource.data.action in ['PAYMENT_SUBMITTED', 'PAYMENT_RESUBMITTED'])
        ) &&
        (!('actorUid' in request.resource.data) || request.resource.data.actorUid == request.auth.uid);

      // Update / Delete: PERMANENTLY FORBIDDEN — audit trail is immutable
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 9. Public Content: Events, Announcements & Schedules
    // ─────────────────────────────────────────────────────────────────────────

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin() || isStaff();
    }

    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 10. Notifications & System Config
    // ─────────────────────────────────────────────────────────────────────────

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        isAdmin()
      );

      allow create: if isAdmin() || isStaff() || (
        isAuthenticated() && request.resource.data.uid == request.auth.uid
      );

      allow update: if isAuthenticated() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt']);

      allow delete: if isAdmin() || (
        isAuthenticated() && resource.data.uid == request.auth.uid
      );
    }

    match /system_config/{configId} {
      allow read: if isAuthenticated();
      // Only super_admin can change system config; admin can read
      allow write: if isSuperAdmin() || isStrictAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Phase 17.1: Email Jobs — Server-side bulk email dispatch queue
    // ─────────────────────────────────────────────────────────────────────────
    match /email_jobs/{jobId} {
      // Admins and above can read any email job
      allow read: if isAdmin() || isSuperAdmin();

      // Only admins and above can create email dispatch jobs
      allow create: if isAdmin() || isSuperAdmin();

      // Only admins can update job status (e.g., retrying failed recipients)
      allow update: if isAdmin() || isSuperAdmin();

      // Only super_admin can delete email job records
      allow delete: if isSuperAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Phase 17.1: Certificate Jobs — Server-side certificate generation queue
    // ─────────────────────────────────────────────────────────────────────────
    match /certificate_jobs/{jobId} {
      // Admins and above can read any certificate job status
      allow read: if isAdmin() || isSuperAdmin();

      // Only admins can create certificate generation jobs
      allow create: if isAdmin() || isSuperAdmin();

      // Allow status updates by admins (progress tracking)
      allow update: if isAdmin() || isSuperAdmin();

      // Only super_admin can delete certificate job records
      allow delete: if isSuperAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Phase 17.1: Certificate Records — Issued e-certificate metadata
    // ─────────────────────────────────────────────────────────────────────────
    match /certificate_records/{certId} {
      // Public verification: allow reading a specific certificate by ID for
      // public verification without authentication
      allow get: if true;

      // Listing: Authenticated users (participants can query their own, admins query all)
      allow list: if isAuthenticated();

      // Creation and updates (issuance and revocation) restricted to administrators
      allow create, update: if isAdmin() || isSuperAdmin();

      // Only super_admin can delete certificate records
      allow delete: if isSuperAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Phase 17: Email Logs — delivery status tracking per email job
    // ─────────────────────────────────────────────────────────────────────────
    match /email_logs/{emailJobId} {
      allow read: if isAdmin() || isSuperAdmin();
      allow write: if isAdmin() || isSuperAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Automated Email Delivery History — Idempotent delivery tracking
    // ─────────────────────────────────────────────────────────────────────────
    match /email_deliveries/{deliveryId} {
      // Restricted to Admins and Service Account (participants cannot read/write)
      allow read: if isAdmin() || isSuperAdmin();
      allow write: if isAdmin() || isSuperAdmin();
    }
  }
}
